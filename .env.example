# =============================================================================
# Nexia — Environment Variables Template
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# =============================================================================

# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ─── Database (PostgreSQL via Docker) ────────────────────────────────────────
DATABASE_URL="postgresql://nexia_user:nexia_password@localhost:5432/nexia_db?schema=public"
POSTGRES_USER=nexia_user
POSTGRES_PASSWORD=nexia_password
POSTGRES_DB=nexia_db

# ─── Authentication ───────────────────────────────────────────────────────────
# Generate strong secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Frontend (Next.js) ───────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# ─── File Storage (local for dev, S3/Cloudinary for prod) ────────────────────
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads

# ─── QR Code Signing ─────────────────────────────────────────────────────────
# Secret used to generate HMAC signatures for QR pass tokens
QR_HMAC_SECRET=change_me_qr_hmac_secret_min_32_chars

# ─── Cors ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000
