{
  "name": "@nexia/api",
  "version": "0.1.0",
  "private": true,
  "description": "Nexia REST API — Express + TypeScript + Prisma (Clean Architecture)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/server.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "clean": "rimraf dist"
  },
  "dependencies": {},
  "devDependencies": {}
}
