{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // ─── Next.js requires these overrides ────────────────────────────────────
    "target": "ES2017",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "preserve",

    // ─── Next.js specifics ───────────────────────────────────────────────────
    "allowJs": false,
    "incremental": true,
    "plugins": [{ "name": "next" }],

    // ─── Path Aliases ─────────────────────────────────────────────────────────
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@nexia/shared-types": ["../../packages/shared-types/src/index.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
